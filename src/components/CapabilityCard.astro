---
interface Props {
  number: string;
  title: string;
  description: string;
  accent?: 'blue' | 'cyan' | 'slate';
}

const {
  number,
  title,
  description,
  accent = 'blue',
} = Astro.props;

const colors = {
  blue: 'text-blue-600',
  cyan: 'text-cyan-600',
  slate: 'text-slate-500',
};
---

<article class="rounded-2xl border border-slate-200 bg-white p-7 shadow-sm transition-shadow hover:shadow-md">
  <p class:list={[
    'text-sm font-bold uppercase tracking-[0.16em]',
    colors[accent],
  ]}>
    {number}
  </p>

  <h3 class="mt-4 text-2xl font-bold text-slate-950">
    {title}
  </h3>

  <p class="mt-3 leading-7 text-slate-600">
    {description}
  </p>

  <div class="mt-6">
    <a
      href={`/${title.toLowerCase()}/`}
      class="text-sm font-semibold text-slate-950 hover:text-blue-600"
    >
      Explore {title}
      <span aria-hidden="true"> →</span>
    </a>
  </div>
</article>
