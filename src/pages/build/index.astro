---
import MainLayout from '../../layouts/MainLayout.astro';
---

<MainLayout
  title="Build | Virtual Concept Technologies"
  description="AI solutions, automation, AI agents and SaaS products."
>
  <main>
    <section class="bg-white">
      <div class="mx-auto max-w-7xl px-6 py-24 lg:px-8 lg:py-32">

        <p class="text-xs font-bold uppercase tracking-[0.2em] text-blue-600">
          VCT / Build
        </p>

        <h1 class="mt-6 max-w-4xl text-5xl font-bold tracking-tight text-slate-950 sm:text-6xl">
          Build AI-powered digital solutions.
        </h1>

        <p class="mt-7 max-w-2xl text-lg leading-8 text-slate-600">
          We build practical AI solutions, automation workflows, AI agents
          and focused SaaS products.
        </p>

        <div class="mt-16 grid gap-6 md:grid-cols-2">

          <a href="/build/ai-solutions/" class="block rounded-2xl border border-slate-200 p-8 transition hover:border-blue-300 hover:shadow-sm">
            <p class="text-xs font-bold text-blue-600">01</p>
            <h2 class="mt-8 text-2xl font-semibold text-slate-950">
              AI Solutions
            </h2>
            <p class="mt-4 leading-7 text-slate-600">
              Practical AI-powered applications designed around real problems
              and useful outcomes.
            </p>
          </a>

          <a href="/build/automation/" class="block rounded-2xl border border-slate-200 p-8 transition hover:border-blue-300 hover:shadow-sm">
            <p class="text-xs font-bold text-blue-600">02</p>
            <h2 class="mt-8 text-2xl font-semibold text-slate-950">
              Automation
            </h2>
            <p class="mt-4 leading-7 text-slate-600">
              Intelligent workflows that reduce repetitive work and improve
              operational efficiency.
            </p>
          </a>

          <a href="/build/ai-agents/" class="block rounded-2xl border border-slate-200 p-8 transition hover:border-blue-300 hover:shadow-sm">
            <p class="text-xs font-bold text-blue-600">03</p>
            <h2 class="mt-8 text-2xl font-semibold text-slate-950">
              AI Agents
            </h2>
            <p class="mt-4 leading-7 text-slate-600">
              Task-focused AI agents designed to assist users and automate
              structured workflows.
            </p>
          </a>

          <a href="/build/saas/" class="block rounded-2xl border border-slate-200 p-8 transition hover:border-blue-300 hover:shadow-sm">
            <p class="text-xs font-bold text-blue-600">04</p>
            <h2 class="mt-8 text-2xl font-semibold text-slate-950">
              SaaS
            </h2>
            <p class="mt-4 leading-7 text-slate-600">
              Focused software products developed from MVP concepts toward
              production applications.
            </p>
          </a>

        </div>

      </div>
    </section>
  </main>
</MainLayout>
