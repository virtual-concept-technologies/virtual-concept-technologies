---
import MainLayout from '../../layouts/MainLayout.astro';
---

<MainLayout
  title="Enable | Virtual Concept Technologies"
  description="Training, AI skills, cybersecurity and SOC training."
>
  <main>
    <section class="bg-white">
      <div class="mx-auto max-w-7xl px-6 py-24 lg:px-8 lg:py-32">

        <p class="text-xs font-bold uppercase tracking-[0.2em] text-blue-600">
          VCT / Enable
        </p>

        <h1 class="mt-6 max-w-4xl text-5xl font-bold tracking-tight text-slate-950 sm:text-6xl">
          Enable people with practical technology skills.
        </h1>

        <p class="mt-7 max-w-2xl text-lg leading-8 text-slate-600">
          Hands-on training designed to develop practical skills in AI
          and cybersecurity.
        </p>

        <div class="mt-16 grid gap-6 md:grid-cols-2">

          <a href="/enable/training/" class="block rounded-2xl border border-slate-200 p-8 transition hover:border-blue-300 hover:shadow-sm">
            <p class="text-xs font-bold text-blue-600">01</p>
            <h2 class="mt-8 text-2xl font-semibold text-slate-950">
              Training
            </h2>
            <p class="mt-4 leading-7 text-slate-600">
              Practical, hands-on technical training built around real
              technology and real-world scenarios.
            </p>
          </a>

          <a href="/enable/ai-skills/" class="block rounded-2xl border border-slate-200 p-8 transition hover:border-blue-300 hover:shadow-sm">
            <p class="text-xs font-bold text-blue-600">02</p>
            <h2 class="mt-8 text-2xl font-semibold text-slate-950">
              AI Skills
            </h2>
            <p class="mt-4 leading-7 text-slate-600">
              Practical learning for understanding and applying modern
              AI tools and technologies.
            </p>
          </a>

          <a href="/enable/cybersecurity/" class="block rounded-2xl border border-slate-200 p-8 transition hover:border-blue-300 hover:shadow-sm">
            <p class="text-xs font-bold text-blue-600">03</p>
            <h2 class="mt-8 text-2xl font-semibold text-slate-950">
              Cybersecurity
            </h2>
            <p class="mt-4 leading-7 text-slate-600">
              Hands-on cybersecurity training focused on practical
              technical scenarios.
            </p>
          </a>

          <a href="/enable/soc/" class="block rounded-2xl border border-slate-200 p-8 transition hover:border-blue-300 hover:shadow-sm">
            <p class="text-xs font-bold text-blue-600">04</p>
            <h2 class="mt-8 text-2xl font-semibold text-slate-950">
              SOC
            </h2>
            <p class="mt-4 leading-7 text-slate-600">
              Practical security operations training using realistic
              monitoring and investigation scenarios.
            </p>
          </a>

        </div>

      </div>
    </section>
  </main>
</MainLayout>
