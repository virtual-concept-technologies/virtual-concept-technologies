---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout
  title="Virtual Concept Technologies | AI-Powered Digital Solutions"
  description="Virtual Concept Technologies builds AI-powered digital solutions, secures digital systems, and enables people with practical AI and cybersecurity skills."
>
  <main>

    <!-- HERO -->
    <section class="bg-white">
      <div class="mx-auto max-w-7xl px-6 pb-24 pt-20 lg:px-8 lg:pb-32 lg:pt-28">

        <div class="max-w-4xl">

          <p class="text-xs font-bold uppercase tracking-[0.22em] text-blue-600">
            Virtual Concept Technologies
          </p>

          <h1 class="mt-6 text-5xl font-bold tracking-tight text-slate-950 sm:text-6xl lg:text-7xl">
            AI-Powered Digital Solutions
          </h1>

          <p class="mt-7 max-w-2xl text-lg leading-8 text-slate-600 sm:text-xl">
            We build practical AI solutions, secure digital systems,
            and enable people with the skills to work with AI and cybersecurity.
          </p>

          <div class="mt-10 flex flex-col gap-3 sm:flex-row">

            <a
              href="/build/"
              class="inline-flex items-center justify-center rounded-lg bg-slate-950 px-6 py-3.5 text-sm font-semibold text-white transition hover:bg-slate-800"
            >
              Explore Build
            </a>

            <a
              href="/enable/"
              class="inline-flex items-center justify-center rounded-lg border border-slate-300 px-6 py-3.5 text-sm font-semibold text-slate-700 transition hover:border-slate-400 hover:bg-slate-50"
            >
              Explore Enable
            </a>

          </div>

        </div>

      </div>
    </section>


    <!-- CORE AREAS -->
    <section class="border-y border-slate-200 bg-slate-50">
      <div class="mx-auto max-w-7xl px-6 py-20 lg:px-8 lg:py-24">

        <div class="max-w-2xl">
          <p class="text-xs font-bold uppercase tracking-[0.2em] text-blue-600">
            What we do
          </p>

          <h2 class="mt-4 text-3xl font-bold tracking-tight text-slate-950 sm:text-4xl">
            Three ways VCT creates value.
          </h2>
        </div>


        <div class="mt-12 grid gap-6 lg:grid-cols-3">

          <!-- BUILD -->
          <a
            href="/build/"
            class="group rounded-2xl border border-slate-200 bg-white p-8 transition hover:-translate-y-1 hover:border-blue-300 hover:shadow-lg"
          >
            <div class="flex items-center justify-between">

              <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-slate-950 text-sm font-bold text-white">
                B
              </span>

              <span class="text-slate-400 transition group-hover:translate-x-1 group-hover:text-blue-600">
                →
              </span>

            </div>

            <h3 class="mt-8 text-2xl font-bold text-slate-950">
              Build
            </h3>

            <p class="mt-4 leading-7 text-slate-600">
              AI solutions, automation, AI agents and SaaS.
            </p>

            <ul class="mt-6 space-y-2 text-sm text-slate-500">
              <li>AI Solutions</li>
              <li>Automation</li>
              <li>AI Agents</li>
              <li>SaaS</li>
            </ul>

          </a>


          <!-- SECURE -->
          <a
            href="/secure/"
            class="group rounded-2xl border border-slate-200 bg-slate-950 p-8 text-white transition hover:-translate-y-1 hover:shadow-lg"
          >
            <div class="flex items-center justify-between">

              <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-white text-sm font-bold text-slate-950">
                S
              </span>

              <span class="text-slate-500 transition group-hover:translate-x-1 group-hover:text-blue-400">
                →
              </span>

            </div>

            <h3 class="mt-8 text-2xl font-bold">
              Secure
            </h3>

            <p class="mt-4 leading-7 text-slate-300">
              Cybersecurity for networks, applications and AI-powered systems.
            </p>

            <ul class="mt-6 space-y-2 text-sm text-slate-400">
              <li>Cybersecurity</li>
              <li>Network Security</li>
              <li>App Security</li>
              <li>AI Security</li>
            </ul>

          </a>


          <!-- ENABLE -->
          <a
            href="/enable/"
            class="group rounded-2xl border border-slate-200 bg-white p-8 transition hover:-translate-y-1 hover:border-blue-300 hover:shadow-lg"
          >
            <div class="flex items-center justify-between">

              <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-blue-600 text-sm font-bold text-white">
                E
              </span>

              <span class="text-slate-400 transition group-hover:translate-x-1 group-hover:text-blue-600">
                →
              </span>

            </div>

            <h3 class="mt-8 text-2xl font-bold text-slate-950">
              Enable
            </h3>

            <p class="mt-4 leading-7 text-slate-600">
              Practical training for AI and cybersecurity skills.
            </p>

            <ul class="mt-6 space-y-2 text-sm text-slate-500">
              <li>Training</li>
              <li>AI Skills</li>
              <li>Cybersecurity</li>
              <li>SOC</li>
            </ul>

          </a>

        </div>

      </div>
    </section>


    <!-- PRODUCT LAYER -->
    <section class="bg-slate-950 text-white">
      <div class="mx-auto max-w-7xl px-6 py-20 lg:px-8 lg:py-24">

        <div class="grid gap-12 lg:grid-cols-[1fr_1.5fr] lg:items-center">

          <div>

            <p class="text-xs font-bold uppercase tracking-[0.2em] text-blue-400">
              VCT Products / SaaS
            </p>

            <h2 class="mt-4 text-3xl font-bold tracking-tight sm:text-4xl">
              Products built from practical ideas.
            </h2>

          </div>

          <div>

            <p class="text-lg leading-8 text-slate-300">
              VCT develops focused digital products and SaaS applications,
              taking ideas from MVP through development and toward production.
            </p>

            <a
              href="/products/"
              class="mt-8 inline-flex items-center gap-2 text-sm font-semibold text-white hover:text-blue-400"
            >
              Explore VCT Products
              <span aria-hidden="true">→</span>
            </a>

          </div>

        </div>

      </div>
    </section>


    <!-- SIMPLE CTA -->
    <section class="bg-white">
      <div class="mx-auto max-w-7xl px-6 py-20 lg:px-8 lg:py-24">

        <div class="rounded-2xl bg-blue-600 px-8 py-12 text-white sm:px-12">

          <div class="max-w-3xl">

            <p class="text-xs font-bold uppercase tracking-[0.2em] text-blue-100">
              Start with a problem
            </p>

            <h2 class="mt-4 text-3xl font-bold tracking-tight sm:text-4xl">
              Have an idea, security challenge, or training need?
            </h2>

            <p class="mt-5 text-lg leading-8 text-blue-50">
              Tell us what you are trying to solve. We can determine the
              right starting point.
            </p>

            <a
              href="/contact/"
              class="mt-8 inline-flex rounded-lg bg-white px-6 py-3.5 text-sm font-semibold text-blue-700 transition hover:bg-blue-50"
            >
              Start a Project
            </a>

          </div>

        </div>

      </div>
    </section>

  </main>
</MainLayout>
