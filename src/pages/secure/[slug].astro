---
import MainLayout from '../../layouts/MainLayout.astro';
import { secureServices } from '../../data/secure';

export function getStaticPaths() {
  return secureServices.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

const { service } = Astro.props;
---

<MainLayout
  title={`${service.title} | Secure | Virtual Concept Technologies`}
  description={service.description}
>
  <main>

    <section class="bg-white">
      <div class="mx-auto max-w-7xl px-6 py-20 sm:py-24 lg:px-8 lg:py-32">

        <a
          href="/secure/"
          class="text-sm font-semibold text-blue-600 hover:text-blue-700"
        >
          ← Back to Secure
        </a>

        <div class="mt-10 max-w-4xl">

          <p class="text-xs font-bold uppercase tracking-[0.2em] text-blue-600">
            VCT / Secure / {service.number}
          </p>

          <h1 class="mt-5 text-4xl font-bold tracking-tight text-slate-950 sm:text-5xl lg:text-6xl">
            {service.title}
          </h1>

          <p class="mt-6 max-w-3xl text-lg leading-8 text-slate-600 sm:text-xl">
            {service.intro}
          </p>

        </div>

        <div class="mt-16 grid gap-6 lg:grid-cols-2">

          <div class="rounded-2xl border border-slate-200 bg-slate-50 p-8 sm:p-10">

            <p class="text-xs font-bold uppercase tracking-[0.16em] text-blue-600">
              Security focus
            </p>

            <ul class="mt-6 space-y-4">
              {service.points.map((point) => (
                <li class="flex gap-3 text-slate-700">
                  <span class="mt-2 h-2 w-2 shrink-0 rounded-full bg-blue-600"></span>
                  <span>{point}</span>
                </li>
              ))}
            </ul>

          </div>

          <div class="rounded-2xl border border-slate-200 p-8 sm:p-10">

            <p class="text-xs font-bold uppercase tracking-[0.16em] text-blue-600">
              Strengthen your security
            </p>

            <h2 class="mt-5 text-2xl font-bold tracking-tight text-slate-950">
              Let's understand your security needs.
            </h2>

            <p class="mt-4 leading-7 text-slate-600">
              Tell us about the systems, applications, networks, or AI
              environments you want to protect and we can determine an
              appropriate starting point.
            </p>

            <a
              href="/contact/"
              class="mt-8 inline-flex rounded-lg bg-blue-600 px-6 py-3 text-sm font-semibold text-white transition hover:bg-blue-700"
            >
              Start a Project
            </a>

          </div>

        </div>

      </div>
    </section>

  </main>
</MainLayout>
